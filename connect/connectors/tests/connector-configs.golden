=== tenant-lexfield-001-outbox.json ===
{
  "name": "tenant-lexfield-001-outbox",
  "config": {
    "connector.class": "io.debezium.connector.sqlserver.SqlServerConnector",
    "topic.prefix": "tenant-lexfield-001",
    "database.hostname": "sql.lexfield.test",
    "database.port": "1433",
    "database.names": "tenant-001",
    "driver.encrypt": "true",
    "driver.authentication": "ActiveDirectoryDefault",
    "table.include.list": "dbo.Outbox",
    "schema.history.internal.kafka.bootstrap.servers": "kafka:9092",
    "schema.history.internal.kafka.topic": "schema-history-lexfield-001",
    "signal.enabled.channels": "source,kafka",
    "signal.kafka.topic": "connect-signals",
    "signal.kafka.bootstrap.servers": "kafka:9092",
    "signal.data.collection": "tenant-001.dbo.DebeziumSignal",
    "errors.max.retries": "10",
    "transforms": "outbox,tenantHeader",
    "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
    "transforms.outbox.table.field.event.id": "Id",
    "transforms.outbox.table.field.event.key": "AggregateId",
    "transforms.outbox.table.field.event.payload": "Payload",
    "transforms.outbox.table.expand.json.payload": "true",
    "transforms.outbox.route.by.field": "AggregateType",
    "transforms.outbox.table.fields.additional.placement": "EventType:header:eventType,Id:header:eventId,TraceParent:header:traceparent",
    "transforms.outbox.route.topic.replacement": "workflow-transitions",
    "transforms.tenantHeader.type": "org.apache.kafka.connect.transforms.InsertHeader",
    "transforms.tenantHeader.header": "tenantId",
    "transforms.tenantHeader.value.literal": "lexfield-001"
  }
}
