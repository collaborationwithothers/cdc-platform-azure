<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio-mcp" modified="2026-08-26T09:00:00.000Z" agent="drawio-mcp/1.0" version="24.7.17" type="device" compressed="false">
  <diagram name="Snapshot window" id="incremental-snapshot-window">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" background="none" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="One incremental-snapshot chunk while streaming continues" style="text;html=1;align=left;verticalAlign=middle;fontSize=25;fontStyle=1;fontColor=#1f4e79;" parent="1" vertex="1"><mxGeometry as="geometry" x="40" y="20" width="1100" height="40" /></mxCell>
        <mxCell id="subtitle" value="The snapshot coordinator and database change stream run concurrently. Markers are observed asynchronously in source order." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#555555;" parent="1" vertex="1"><mxGeometry as="geometry" x="40" y="60" width="1300" height="30" /></mxCell>
        <mxCell id="snapshot-zone" value="Snapshot coordinator lane" style="swimlane;startSize=24;whiteSpace=wrap;html=1;fillColor=#f5f9ff;strokeColor=#4472c4;strokeWidth=2;fontSize=15;fontStyle=1;" parent="1" vertex="1"><mxGeometry as="geometry" x="40" y="120" width="500" height="750" /></mxCell>
        <mxCell id="stream-zone" value="SQL Server change stream lane" style="swimlane;startSize=24;whiteSpace=wrap;html=1;fillColor=#f4ecf7;strokeColor=#9673a6;strokeWidth=2;fontSize=15;fontStyle=1;" parent="1" vertex="1"><mxGeometry as="geometry" x="570" y="120" width="500" height="750" /></mxCell>
        <mxCell id="output-zone" value="Deduplication and output lane" style="swimlane;startSize=24;whiteSpace=wrap;html=1;fillColor=#fff8e6;strokeColor=#d6b656;strokeWidth=2;fontSize=15;fontStyle=1;" parent="1" vertex="1"><mxGeometry as="geometry" x="1100" y="120" width="650" height="750" /></mxCell>
        <mxCell id="prepare" value="C1  Select next chunk&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Primary keys 1 to 100&lt;br&gt;Snapshot endpoint already recorded&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4472c4;fontSize=14;fontStyle=1;" parent="snapshot-zone" vertex="1"><mxGeometry as="geometry" x="140" y="60" width="220" height="80" /></mxCell>
        <mxCell id="open-write" value="C2  Insert OPEN&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Write watermark row to&lt;br&gt;dbo.DebeziumSignal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;" parent="snapshot-zone" vertex="1"><mxGeometry as="geometry" x="140" y="170" width="220" height="90" /></mxCell>
        <mxCell id="open-observe" value="S1  Change data capture (CDC)&lt;br&gt;observes OPEN&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Window becomes active only when&lt;br&gt;the marker reaches the source stream&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;" parent="stream-zone" vertex="1"><mxGeometry as="geometry" x="130" y="100" width="240" height="100" /></mxCell>
        <mxCell id="read" value="C3  Read dbo.Outbox chunk&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Current rows 1 to 100&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4472c4;fontSize=14;fontStyle=1;" parent="snapshot-zone" vertex="1"><mxGeometry as="geometry" x="140" y="290" width="220" height="90" /></mxCell>
        <mxCell id="buffer" value="C4  Buffer READ events&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Keyed by primary key&lt;br&gt;Includes stale READ for row 42&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;" parent="snapshot-zone" vertex="1"><mxGeometry as="geometry" x="140" y="410" width="220" height="100" /></mxCell>
        <mxCell id="change" value="S2  Live row 42 changes&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;SQL Server CDC emits the newer&lt;br&gt;UPDATE or DELETE event&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" parent="stream-zone" vertex="1"><mxGeometry as="geometry" x="130" y="300" width="240" height="100" /></mxCell>
        <mxCell id="decision" value="D1  Does the streamed key&lt;br&gt;match a buffered READ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" parent="output-zone" vertex="1"><mxGeometry as="geometry" x="200" y="100" width="240" height="140" /></mxCell>
        <mxCell id="no-match" value="D2  No match&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Emit the streamed event now&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=13;fontStyle=1;" parent="output-zone" vertex="1"><mxGeometry as="geometry" x="40" y="360" width="220" height="90" /></mxCell>
        <mxCell id="match" value="D2  Match: row 42&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Remove stale buffered READ&lt;br&gt;Emit the newer streamed event&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" parent="output-zone" vertex="1"><mxGeometry as="geometry" x="390" y="350" width="220" height="110" /></mxCell>
        <mxCell id="close-write" value="C5  Insert CLOSE&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Write the second watermark row&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;" parent="snapshot-zone" vertex="1"><mxGeometry as="geometry" x="140" y="540" width="220" height="90" /></mxCell>
        <mxCell id="close-observe" value="S3  CDC observes CLOSE&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;The ordered stream proves all&lt;br&gt;changes inside the window were seen&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;" parent="stream-zone" vertex="1"><mxGeometry as="geometry" x="130" y="510" width="240" height="100" /></mxCell>
        <mxCell id="flush" value="D3  Emit remaining READs&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Rows not superseded by live changes&lt;br&gt;Row 42 READ is absent&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=14;fontStyle=1;" parent="output-zone" vertex="1"><mxGeometry as="geometry" x="200" y="490" width="240" height="100" /></mxCell>
        <mxCell id="smt" value="D4  Apply Kafka Connect transforms&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;outbox -&gt; tenantHeader&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" parent="output-zone" vertex="1"><mxGeometry as="geometry" x="30" y="630" width="190" height="80" /></mxCell>
        <mxCell id="output" value="D5  workflow-transitions&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Live event for row 42&lt;br&gt;READ events for unchanged rows&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#fce4d6;strokeColor=#c55a11;fontSize=13;fontStyle=1;" parent="output-zone" vertex="1"><mxGeometry as="geometry" x="240" y="620" width="190" height="100" /></mxCell>
        <mxCell id="checkpoint" value="D6  Commit progress&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;connect-offsets records source and&lt;br&gt;snapshot context, then next chunk starts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=14;fontStyle=1;" parent="output-zone" vertex="1"><mxGeometry as="geometry" x="450" y="630" width="180" height="80" /></mxCell>
        <mxCell id="principle" value="Why CDC on the signal table is required&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Debezium controls the writes, but a successful INSERT does not prove that the CDC reader has reached that point. Seeing OPEN and CLOSE in the same source stream as Outbox changes creates the ordering boundary used for deduplication.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4ecf7;strokeColor=#9673a6;strokeWidth=2;fontSize=14;fontStyle=1;align=left;spacingLeft=12;" parent="1" vertex="1"><mxGeometry as="geometry" x="40" y="910" width="820" height="140" /></mxCell>
        <mxCell id="result" value="Result for the example&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;The destination receives the newer live row 42 event, not its older snapshot READ. Unchanged rows are emitted as READ events after CLOSE. Streaming never pauses.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f8f1;strokeColor=#70ad47;strokeWidth=2;fontSize=14;fontStyle=1;align=left;spacingLeft=12;" parent="1" vertex="1"><mxGeometry as="geometry" x="900" y="910" width="850" height="140" /></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4472c4;strokeWidth=2;endArrow=block;flowAnimation=1;" parent="1" edge="1" source="prepare" target="open-write"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;flowAnimation=1;" parent="1" edge="1" source="open-write" target="open-observe"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e2a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;flowAnimation=1;" parent="1" edge="1" source="open-observe" target="change"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;flowAnimation=1;" parent="1" edge="1" source="open-write" target="read"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4472c4;strokeWidth=2;endArrow=block;flowAnimation=1;" parent="1" edge="1" source="read" target="buffer"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d6b656;strokeWidth=2;endArrow=block;flowAnimation=1;" parent="1" edge="1" source="buffer" target="close-write"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e6" value="compare primary key" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d6b656;strokeWidth=2;endArrow=block;flowAnimation=1;fontSize=11;" parent="1" edge="1" source="change" target="decision"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e7-no" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#70ad47;strokeWidth=2;endArrow=block;fontSize=11;" parent="1" edge="1" source="decision" target="no-match"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e7-yes" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=block;fontSize=11;" parent="1" edge="1" source="decision" target="match"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;flowAnimation=1;" parent="1" edge="1" source="close-write" target="close-observe"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#70ad47;strokeWidth=2;endArrow=block;" parent="1" edge="1" source="close-observe" target="flush"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d6b656;strokeWidth=2;endArrow=block;" parent="1" edge="1" source="flush" target="smt"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#c55a11;strokeWidth=2;endArrow=block;flowAnimation=1;" parent="1" edge="1" source="smt" target="output"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#70ad47;strokeWidth=2;endArrow=block;" parent="1" edge="1" source="output" target="checkpoint"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="legend" value="Animated arrows show the order of work. The snapshot buffer exists only between the observed OPEN and CLOSE markers." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1"><mxGeometry as="geometry" x="40" y="1080" width="920" height="50" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
