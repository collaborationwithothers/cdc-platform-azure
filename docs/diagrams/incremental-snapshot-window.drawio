<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio-mcp" modified="2026-08-26T17:49:26.000Z" agent="drawio-mcp/1.0" version="24.7.17" type="device" compressed="false">
  <diagram name="Snapshot window" id="incremental-snapshot-window">
    <mxGraphModel dx="1354" dy="981" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" background="none" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="How one snapshot chunk stays correct while live changes continue" style="text;html=1;align=left;verticalAlign=middle;fontSize=25;fontStyle=1;fontColor=#1f4e79;" parent="1" vertex="1"><mxGeometry as="geometry" x="40" y="20" width="1100" height="40" /></mxCell>
        <mxCell id="subtitle" value="A chunk is a small group of current rows. OPEN and CLOSE markers tell the connector which live changes happened while it read that group." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#555555;" parent="1" vertex="1"><mxGeometry as="geometry" x="40" y="60" width="1300" height="30" /></mxCell>
        <mxCell id="snapshot-zone" value="Snapshot work area" style="swimlane;startSize=24;whiteSpace=wrap;html=1;fillColor=#f5f9ff;strokeColor=#4472c4;strokeWidth=2;fontSize=15;fontStyle=1;" parent="1" vertex="1"><mxGeometry as="geometry" x="40" y="120" width="500" height="750" /></mxCell>
        <mxCell id="stream-zone" value="Azure SQL change stream area" style="swimlane;startSize=24;whiteSpace=wrap;html=1;fillColor=#f4ecf7;strokeColor=#9673a6;strokeWidth=2;fontSize=15;fontStyle=1;" parent="1" vertex="1"><mxGeometry as="geometry" x="570" y="120" width="500" height="750" /></mxCell>
        <mxCell id="output-zone" value="Deduplication and output area" style="swimlane;startSize=24;whiteSpace=wrap;html=1;fillColor=#fff8e6;strokeColor=#d6b656;strokeWidth=2;fontSize=15;fontStyle=1;" parent="1" vertex="1"><mxGeometry as="geometry" x="1100" y="120" width="650" height="750" /></mxCell>
        <mxCell id="prepare" value="C1  Choose the next chunk&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Primary keys 1 to 100&lt;br&gt;record the database end position&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4472c4;fontSize=14;fontStyle=1;" parent="snapshot-zone" vertex="1"><mxGeometry as="geometry" x="140" y="60" width="220" height="80" /></mxCell>
        <mxCell id="open-write" value="C2  Write OPEN marker&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;insert a row into&lt;br&gt;dbo.DebeziumSignal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;" parent="snapshot-zone" vertex="1"><mxGeometry as="geometry" x="140" y="170" width="220" height="90" /></mxCell>
        <mxCell id="open-observe" value="S1  CDC reads OPEN&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;the snapshot window starts when&lt;br&gt;OPEN reaches the change stream&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;" parent="stream-zone" vertex="1"><mxGeometry as="geometry" x="130" y="100" width="240" height="100" /></mxCell>
        <mxCell id="read" value="C3  Read current Outbox rows&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;primary keys 1 to 100&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4472c4;fontSize=14;fontStyle=1;" parent="snapshot-zone" vertex="1"><mxGeometry as="geometry" x="140" y="290" width="220" height="90" /></mxCell>
        <mxCell id="buffer" value="C4  Hold snapshot READ events&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;one event per primary key&lt;br&gt;includes an older value for row 42&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;" parent="snapshot-zone" vertex="1"><mxGeometry as="geometry" x="140" y="410" width="220" height="100" /></mxCell>
        <mxCell id="change" value="S2  Row 42 changes&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;CDC emits the newer UPDATE&lt;br&gt;or DELETE event&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" parent="stream-zone" vertex="1"><mxGeometry as="geometry" x="130" y="300" width="240" height="100" /></mxCell>
        <mxCell id="decision" value="D1  Does this live event&lt;br&gt;match a buffered READ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" parent="output-zone" vertex="1"><mxGeometry as="geometry" x="200" y="100" width="240" height="140" /></mxCell>
        <mxCell id="no-match" value="D2  No match&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;send the live event now&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=13;fontStyle=1;" parent="output-zone" vertex="1"><mxGeometry as="geometry" x="40" y="360" width="220" height="90" /></mxCell>
        <mxCell id="match" value="D3  Match: row 42&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;remove the older READ&lt;br&gt;send the newer live event&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" parent="output-zone" vertex="1"><mxGeometry as="geometry" x="390" y="350" width="220" height="110" /></mxCell>
        <mxCell id="close-write" value="C5  Write CLOSE marker&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;insert the second row into&lt;br&gt;dbo.DebeziumSignal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;" parent="snapshot-zone" vertex="1"><mxGeometry as="geometry" x="140" y="540" width="220" height="90" /></mxCell>
        <mxCell id="close-observe" value="S3  CDC reads CLOSE&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;all live changes inside this&lt;br&gt;snapshot window are now known&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;" parent="stream-zone" vertex="1"><mxGeometry as="geometry" x="130" y="510" width="240" height="100" /></mxCell>
        <mxCell id="flush" value="D4  Send remaining READs&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;send rows with no newer live event&lt;br&gt;do not send the old row 42 READ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=14;fontStyle=1;" parent="output-zone" vertex="1"><mxGeometry as="geometry" x="200" y="490" width="240" height="100" /></mxCell>
        <mxCell id="smt" value="D5  Apply Kafka Connect transforms&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;dropNonOutbox -&gt; outbox -&gt; tenantHeader&lt;br&gt;keep Outbox -&gt; unwrap -&gt; add tenant&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" parent="output-zone" vertex="1"><mxGeometry as="geometry" x="200" y="620" width="250" height="95" /></mxCell>
        <mxCell id="output" value="D6  workflow-transitions&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;new live event for row 42&lt;br&gt;READ events for unchanged rows&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#fce4d6;strokeColor=#c55a11;fontSize=13;fontStyle=1;" parent="output-zone" vertex="1"><mxGeometry as="geometry" x="470" y="620" width="170" height="105" /></mxCell>
        <mxCell id="checkpoint" value="Kafka Connect checkpoint&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;saves the source position&lt;br&gt;and snapshot progress periodically&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=14;fontStyle=1;" parent="output-zone" vertex="1"><mxGeometry as="geometry" x="470" y="500" width="170" height="95" /></mxCell>
        <mxCell id="principle" value="Why the signal table also needs CDC&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Writing OPEN and CLOSE rows is not enough. The connector must read those markers through the same CDC stream as Outbox changes. That shared order tells it which live events happened during the chunk.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4ecf7;strokeColor=#9673a6;strokeWidth=2;fontSize=14;fontStyle=1;align=left;spacingLeft=12;" parent="1" vertex="1"><mxGeometry as="geometry" x="40" y="910" width="820" height="140" /></mxCell>
        <mxCell id="result" value="Result for this example&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;The destination gets the newer live event for row 42, not the older snapshot READ. It gets READ events for unchanged rows after CLOSE. Live streaming never stops.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f8f1;strokeColor=#70ad47;strokeWidth=2;fontSize=14;fontStyle=1;align=left;spacingLeft=12;" parent="1" vertex="1"><mxGeometry as="geometry" x="900" y="910" width="850" height="140" /></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4472c4;strokeWidth=2;endArrow=block;flowAnimation=1;" parent="1" edge="1" source="prepare" target="open-write"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;flowAnimation=1;" parent="1" edge="1" source="open-write" target="open-observe"><mxGeometry as="geometry" relative="1"></mxGeometry></mxCell>
        <mxCell id="e2a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;flowAnimation=1;" parent="1" edge="1" source="open-observe" target="change"><mxGeometry as="geometry" relative="1"></mxGeometry></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;flowAnimation=1;" parent="1" edge="1" source="open-write" target="read"><mxGeometry as="geometry" relative="1"></mxGeometry></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4472c4;strokeWidth=2;endArrow=block;flowAnimation=1;" parent="1" edge="1" source="read" target="buffer"><mxGeometry as="geometry" relative="1"></mxGeometry></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d6b656;strokeWidth=2;endArrow=block;flowAnimation=1;" parent="1" edge="1" source="buffer" target="close-write"><mxGeometry as="geometry" relative="1"></mxGeometry></mxCell>
        <mxCell id="e6" value="Compare the primary key" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d6b656;strokeWidth=2;endArrow=block;flowAnimation=1;fontSize=12;" parent="1" edge="1" source="change" target="decision"><mxGeometry as="geometry" relative="1"></mxGeometry></mxCell>
        <mxCell id="e7-no" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#70ad47;strokeWidth=2;endArrow=block;fontSize=12;" parent="1" edge="1" source="decision" target="no-match"><mxGeometry as="geometry" relative="1"></mxGeometry></mxCell>
        <mxCell id="e7-yes" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=block;fontSize=12;" parent="1" edge="1" source="decision" target="match"><mxGeometry as="geometry" relative="1"></mxGeometry></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;flowAnimation=1;" parent="1" edge="1" source="close-write" target="close-observe"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#70ad47;strokeWidth=2;endArrow=block;" parent="1" edge="1" source="close-observe" target="flush"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d6b656;strokeWidth=2;endArrow=block;" parent="1" edge="1" source="flush" target="smt"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#c55a11;strokeWidth=2;endArrow=block;flowAnimation=1;" parent="1" edge="1" source="smt" target="output"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#70ad47;strokeWidth=2;endArrow=block;fontSize=12;" parent="1" edge="1" source="output" target="checkpoint"><mxGeometry as="geometry" relative="1"></mxGeometry></mxCell>
        <mxCell id="legend" value="Animated arrows show records moving. The snapshot buffer exists until the connector reads CLOSE. A checkpoint is periodic, not a barrier after every chunk." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=8;" parent="1" vertex="1"><mxGeometry as="geometry" x="40" y="1080" width="1100" height="50" /></mxCell>
        <mxCell id="azure-sql-icon" value="Azure SQL" style="shape=image;aspect=fixed;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;image=img/lib/azure2/databases/SQL_Database.svg;" parent="stream-zone" vertex="1"><mxGeometry as="geometry" x="420" y="40" width="55" height="55" /></mxCell>
        <mxCell id="2" value="Live event" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#c55a11;strokeWidth=2;endArrow=block;flowAnimation=1;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" parent="output-zone" edge="1" source="no-match" target="smt"><mxGeometry as="geometry" relative="1"></mxGeometry></mxCell>
        <mxCell id="3" value="Newer live event" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#c55a11;strokeWidth=2;endArrow=block;flowAnimation=1;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;entryPerimeter=0;" parent="output-zone" edge="1" source="match" target="smt"><mxGeometry as="geometry" relative="1"></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
