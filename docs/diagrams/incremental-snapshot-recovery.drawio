<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio-mcp" modified="2026-08-26T09:00:00.000Z" agent="drawio-mcp/1.0" version="24.7.17" type="device" compressed="false">
  <diagram name="Crash recovery" id="incremental-snapshot-recovery">
    <mxGraphModel dx="1800" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1150" background="none" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Resume from committed snapshot context after worker loss" style="text;html=1;align=left;verticalAlign=middle;fontSize=25;fontStyle=1;fontColor=#1f4e79;" parent="1" vertex="1"><mxGeometry as="geometry" x="40" y="20" width="1100" height="40" /></mxCell>
        <mxCell id="subtitle" value="A crash loses the current memory buffer. Durable Kafka and SQL state determine what is replayed." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#555555;" parent="1" vertex="1"><mxGeometry as="geometry" x="40" y="62" width="1200" height="30" /></mxCell>
        <mxCell id="before-zone" value="Before the crash: Worker A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e6;strokeColor=#d6b656;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=15;fontStyle=1;connectable=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="40" y="120" width="500" height="470" /></mxCell>
        <mxCell id="durable-zone" value="Durable recovery authority" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f8f1;strokeColor=#70ad47;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=15;fontStyle=1;connectable=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="575" y="120" width="650" height="470" /></mxCell>
        <mxCell id="after-zone" value="After reassignment: Worker B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f9ff;strokeColor=#4472c4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=15;fontStyle=1;connectable=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="1260" y="120" width="490" height="470" /></mxCell>
        <mxCell id="worker-a" value="1  Connector is streaming&lt;br&gt;and snapshotting a chunk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" parent="1" vertex="1"><mxGeometry as="geometry" x="85" y="190" width="210" height="80" /></mxCell>
        <mxCell id="buffer-a" value="In-memory window buffer&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;READ events for current chunk&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry as="geometry" x="340" y="190" width="165" height="80" /></mxCell>
        <mxCell id="checkpoint-a" value="2  Periodic checkpoint&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Commit LSN and snapshot context&lt;br&gt;to connect-offsets&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry as="geometry" x="85" y="340" width="210" height="85" /></mxCell>
        <mxCell id="crash" value="3  Worker A crashes&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Buffer disappears immediately&lt;br&gt;OPEN may have no matching CLOSE yet&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=14;fontStyle=1;" parent="1" vertex="1"><mxGeometry as="geometry" x="340" y="455" width="165" height="95" /></mxCell>
        <mxCell id="connect-configs" value="connect-configs&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;connector configuration&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry as="geometry" x="615" y="180" width="170" height="90" /></mxCell>
        <mxCell id="connect-offsets" value="connect-offsets&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;committed SQL LSN&lt;br&gt;+ incremental snapshot context&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry as="geometry" x="615" y="365" width="180" height="105" /></mxCell>
        <mxCell id="schema-history" value="schema-history-{tenantId}&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;schema needed to decode&lt;br&gt;historical changes&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry as="geometry" x="835" y="170" width="165" height="110" /></mxCell>
        <mxCell id="sql-cdc" value="SQL Server CDC rows&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;changes remain until cleanup&lt;br&gt;retention removes them&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry as="geometry" x="1035" y="365" width="165" height="105" /></mxCell>
        <mxCell id="signal-offset" value="__consumer_offsets&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;kafka-signal command position&lt;br&gt;separate from source progress&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry as="geometry" x="825" y="365" width="180" height="105" /></mxCell>
        <mxCell id="signal-markers" value="dbo.DebeziumSignal&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;window markers in CDC&lt;br&gt;not the restart cursor&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry as="geometry" x="1035" y="170" width="165" height="110" /></mxCell>
        <mxCell id="assign" value="4  Connect assigns the&lt;br&gt;connector to Worker B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4472c4;fontSize=14;fontStyle=1;" parent="1" vertex="1"><mxGeometry as="geometry" x="1305" y="185" width="190" height="85" /></mxCell>
        <mxCell id="reload" value="5  Reload durable state&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;config + schema + offsets&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=14;fontStyle=1;" parent="1" vertex="1"><mxGeometry as="geometry" x="1525" y="185" width="185" height="85" /></mxCell>
        <mxCell id="resume-stream" value="6  Resume CDC from the&lt;br&gt;last committed LSN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;" parent="1" vertex="1"><mxGeometry as="geometry" x="1305" y="350" width="190" height="85" /></mxCell>
        <mxCell id="resume-snapshot" value="7  Resume after the last&lt;br&gt;committed snapshot key&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;rebuild window and buffer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4472c4;fontSize=14;fontStyle=1;" parent="1" vertex="1"><mxGeometry as="geometry" x="1525" y="340" width="185" height="105" /></mxCell>
        <mxCell id="duplicate-zone" value="At-least-once boundary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e6;strokeColor=#d6b656;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=15;fontStyle=1;connectable=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="40" y="635" width="1710" height="310" /></mxCell>
        <mxCell id="emitted" value="8  Was a record published&lt;br&gt;before the crash but not covered&lt;br&gt;by the committed offset?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry as="geometry" x="110" y="720" width="260" height="145" /></mxCell>
        <mxCell id="replay" value="Yes: emit it again&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Duplicate is allowed&lt;br&gt;downstream must be idempotent&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry as="geometry" x="480" y="725" width="230" height="100" /></mxCell>
        <mxCell id="continue" value="No: continue from the&lt;br&gt;committed boundary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry as="geometry" x="480" y="850" width="230" height="70" /></mxCell>
        <mxCell id="complete" value="9  Finish remaining chunks&lt;br&gt;and commit completed state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=14;fontStyle=1;" parent="1" vertex="1"><mxGeometry as="geometry" x="820" y="770" width="240" height="90" /></mxCell>
        <mxCell id="limits" value="Recovery limits&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;- SQL CDC retention must still contain the committed LSN.&lt;br&gt;- Losing connect-offsets or schema history is a different recovery incident.&lt;br&gt;- SQL Server schema changes are unsupported during an incremental snapshot.&lt;br&gt;- Normal resume is documented design, not yet container-proven by #68.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;fontStyle=1;align=left;spacingLeft=10;" parent="1" vertex="1"><mxGeometry as="geometry" x="1160" y="705" width="520" height="180" /></mxCell>
        <mxCell id="e1" value="current READs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d6b656;strokeWidth=2;endArrow=block;flowAnimation=1;fontSize=11;" parent="1" edge="1" source="worker-a" target="buffer-a"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#70ad47;strokeWidth=2;endArrow=block;flowAnimation=1;" parent="1" edge="1" source="worker-a" target="checkpoint-a"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e-crash" value="memory lost" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=block;flowAnimation=1;fontSize=11;" parent="1" edge="1" source="buffer-a" target="crash"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e4" value="reassign" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4472c4;strokeWidth=2;endArrow=block;flowAnimation=1;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" edge="1" source="crash" target="assign"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="560" y="525" /><mxPoint x="1235" y="525" /><mxPoint x="1235" y="228" /></Array></mxGeometry></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4472c4;strokeWidth=2;endArrow=block;flowAnimation=1;" parent="1" edge="1" source="assign" target="reload"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e6" value="stream changes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;flowAnimation=1;fontSize=11;" parent="1" edge="1" source="sql-cdc" target="resume-stream"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4472c4;strokeWidth=2;endArrow=block;flowAnimation=1;" parent="1" edge="1" source="resume-stream" target="resume-snapshot"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d6b656;strokeWidth=2;endArrow=block;flowAnimation=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" edge="1" source="resume-snapshot" target="emitted"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1618" y="680" /><mxPoint x="240" y="680" /></Array></mxGeometry></mxCell>
        <mxCell id="e-yes" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=block;flowAnimation=1;fontSize=11;" parent="1" edge="1" source="emitted" target="replay"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e-no" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#70ad47;strokeWidth=2;endArrow=block;flowAnimation=1;fontSize=11;" parent="1" edge="1" source="emitted" target="continue"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e-replay-complete" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#70ad47;strokeWidth=2;endArrow=block;flowAnimation=1;" parent="1" edge="1" source="replay" target="complete"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e-continue-complete" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#70ad47;strokeWidth=2;endArrow=block;flowAnimation=1;" parent="1" edge="1" source="continue" target="complete"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="legend" value="Animated arrows = runtime flow. Green and purple cylinder shapes = durable state that survives Worker A." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1"><mxGeometry as="geometry" x="40" y="985" width="840" height="45" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
