<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio-mcp" modified="2026-08-26T17:54:27.000Z" agent="drawio-mcp/1.0" version="24.7.17" type="device" compressed="false">
  <diagram name="Crash recovery" id="incremental-snapshot-recovery">
    <mxGraphModel dx="1354" dy="981" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1300" background="none" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="What happens after a Kafka Connect worker crashes" style="html=1;text;align=left;verticalAlign=middle;fontSize=25;fontStyle=1;fontColor=#1f4e79;" parent="1" vertex="1"><mxGeometry as="geometry" x="40.0" y="20.0" width="1100.0" height="40.0" /></mxCell>
        <mxCell id="subtitle" value="The worker loses its in-memory snapshot buffer. Kafka Connect reloads saved state, then reads Azure SQL changes again from the last saved position." style="html=1;text;align=left;verticalAlign=middle;fontSize=14;fontColor=#555555;" parent="1" vertex="1"><mxGeometry as="geometry" x="40.0" y="60.0" width="1400.0" height="30.0" /></mxCell>
        <mxCell id="before-zone" value="Before the crash: Worker A" style="html=1;swimlane;startSize=24;whiteSpace=wrap;fillColor=#fff8e6;strokeColor=#d6b656;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=15;fontStyle=1;connectable=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="40.0" y="120.0" width="500.0" height="470.0" /></mxCell>
        <mxCell id="durable-zone" value="Saved state that survives" style="html=1;swimlane;startSize=24;whiteSpace=wrap;fillColor=#f1f8f1;strokeColor=#70ad47;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=15;fontStyle=1;connectable=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="580.0" y="120.0" width="650.0" height="470.0" /></mxCell>
        <mxCell id="after-zone" value="After the crash: Worker B takes over" style="html=1;swimlane;startSize=24;whiteSpace=wrap;fillColor=#f5f9ff;strokeColor=#4472c4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=15;fontStyle=1;connectable=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="1260.0" y="120.0" width="490.0" height="470.0" /></mxCell>
        <mxCell id="worker-a" value="1  Read live changes&lt;br&gt;and one snapshot chunk" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" parent="before-zone" vertex="1"><mxGeometry as="geometry" x="50.0" y="70.0" width="210.0" height="80.0" /></mxCell>
        <mxCell id="buffer-a" value="In-memory snapshot buffer&lt;br&gt;READ events for the current chunk" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" parent="before-zone" vertex="1"><mxGeometry as="geometry" x="300.0" y="70.0" width="170.0" height="80.0" /></mxCell>
        <mxCell id="checkpoint-a" value="2  Save progress periodically&lt;br&gt;Azure SQL log position&lt;br&gt;and snapshot progress&lt;br&gt;go to connect-offsets" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=13;fontStyle=1;" parent="before-zone" vertex="1"><mxGeometry as="geometry" x="50.0" y="220.0" width="210.0" height="90.0" /></mxCell>
        <mxCell id="crash" value="3  Worker A crashes&lt;br&gt;the snapshot buffer is lost&lt;br&gt;OPEN may not have a matching CLOSE" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=14;fontStyle=1;" parent="before-zone" vertex="1"><mxGeometry as="geometry" x="300.0" y="340.0" width="170.0" height="100.0" /></mxCell>
        <mxCell id="connect-configs" value="connect-configs&lt;br&gt;connector settings" style="html=1;shape=cylinder;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=13;fontStyle=1;" parent="durable-zone" vertex="1"><mxGeometry as="geometry" x="40.0" y="60.0" width="170.0" height="90.0" /></mxCell>
        <mxCell id="connect-offsets" value="connect-offsets&lt;br&gt;saved Azure SQL log position&lt;br&gt;and snapshot progress" style="html=1;shape=cylinder;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=13;fontStyle=1;" parent="durable-zone" vertex="1"><mxGeometry as="geometry" x="40.0" y="250.0" width="180.0" height="110.0" /></mxCell>
        <mxCell id="schema-history" value="schema-history-{tenantId}&lt;br&gt;table definitions needed&lt;br&gt;to read older changes" style="html=1;shape=cylinder;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=13;fontStyle=1;" parent="durable-zone" vertex="1"><mxGeometry as="geometry" x="260.0" y="50.0" width="170.0" height="110.0" /></mxCell>
        <mxCell id="sql-cdc" value="Azure SQL CDC rows&lt;br&gt;changes stay until the&lt;br&gt;retention period removes them" style="html=1;shape=cylinder;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" parent="durable-zone" vertex="1"><mxGeometry as="geometry" x="460.0" y="250.0" width="170.0" height="110.0" /></mxCell>
        <mxCell id="signal-offset" value="__consumer_offsets&lt;br&gt;saved snapshot-request position&lt;br&gt;not proof that a snapshot started" style="html=1;shape=cylinder;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=13;fontStyle=1;" parent="durable-zone" vertex="1"><mxGeometry as="geometry" x="250.0" y="250.0" width="180.0" height="110.0" /></mxCell>
        <mxCell id="signal-markers" value="dbo.DebeziumSignal&lt;br&gt;OPEN and CLOSE rows in CDC&lt;br&gt;not the restart position" style="html=1;shape=cylinder;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" parent="durable-zone" vertex="1"><mxGeometry as="geometry" x="460.0" y="50.0" width="170.0" height="110.0" /></mxCell>
        <mxCell id="assign" value="4  Kafka Connect assigns&lt;br&gt;the connector to Worker B" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#4472c4;fontSize=14;fontStyle=1;" parent="after-zone" vertex="1"><mxGeometry as="geometry" x="40" y="40" width="400" height="75" /></mxCell>
        <mxCell id="reload" value="5  Reload saved settings,&lt;br&gt;table definitions, and offsets" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=14;fontStyle=1;" parent="after-zone" vertex="1"><mxGeometry as="geometry" x="40" y="140" width="400" height="75" /></mxCell>
        <mxCell id="resume-stream" value="6  Read CDC again from the&lt;br&gt;last saved Azure SQL position" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;" parent="after-zone" vertex="1"><mxGeometry as="geometry" x="40" y="240" width="400" height="75" /></mxCell>
        <mxCell id="resume-snapshot" value="7  Continue after the last&lt;br&gt;saved snapshot key&lt;br&gt;rebuild the in-memory buffer" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#4472c4;fontSize=14;fontStyle=1;" parent="after-zone" vertex="1"><mxGeometry as="geometry" x="40" y="340" width="400" height="85" /></mxCell>
        <mxCell id="duplicate-zone" value="Replay check after a crash" style="html=1;swimlane;startSize=24;whiteSpace=wrap;fillColor=#fff8e6;strokeColor=#d6b656;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=15;fontStyle=1;connectable=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="40.0" y="640.0" width="1710.0" height="460.0" /></mxCell>
        <mxCell id="emitted" value="8  Was a record sent before&lt;br&gt;the crash but not included&lt;br&gt;in the saved offset?" style="html=1;rhombus;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" parent="duplicate-zone" vertex="1"><mxGeometry as="geometry" x="660.0" y="120.0" width="240.0" height="150.0" /></mxCell>
        <mxCell id="replay" value="Yes: send it again&lt;br&gt;the destination must safely&lt;br&gt;ignore the duplicate" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" parent="duplicate-zone" vertex="1"><mxGeometry as="geometry" x="980.0" y="70.0" width="240.0" height="110.0" /></mxCell>
        <mxCell id="continue" value="No: continue from the&lt;br&gt;saved position" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=13;fontStyle=1;" parent="duplicate-zone" vertex="1"><mxGeometry as="geometry" x="980.0" y="230.0" width="240.0" height="80.0" /></mxCell>
        <mxCell id="complete" value="9  Finish the remaining chunks&lt;br&gt;and save completed state" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=14;fontStyle=1;" parent="duplicate-zone" vertex="1"><mxGeometry as="geometry" x="1380.0" y="140.0" width="250.0" height="90.0" /></mxCell>
        <mxCell id="signal-outcomes" value="Snapshot request checkpoint&lt;br&gt;- If the Kafka position was not saved, the connector can read the request again.&lt;br&gt;- If the Kafka position was saved before snapshot progress, an operator may need to send the request again.&lt;br&gt;- Neither checkpoint proves which snapshot rows reached workflow-transitions." style="html=1;rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;align=left;spacingLeft=10;" parent="duplicate-zone" vertex="1"><mxGeometry as="geometry" x="40.0" y="60.0" width="540.0" height="170.0" /></mxCell>
        <mxCell id="limits" value="Recovery limits&lt;br&gt;- Azure SQL CDC must still contain the saved log position.&lt;br&gt;- Losing connect-offsets or schema history is a different incident.&lt;br&gt;- Do not change the Azure SQL table schema during a snapshot.&lt;br&gt;- Normal resume is the documented design. Issue 68 has not yet proved it with containers." style="html=1;rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#999999;fontSize=13;fontStyle=1;align=left;spacingLeft=10;" parent="duplicate-zone" vertex="1"><mxGeometry as="geometry" x="40.0" y="250.0" width="540.0" height="160.0" /></mxCell>
        <mxCell id="e1" value="Current READs" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#d6b656;strokeWidth=2;endArrow=block;fontSize=12;" parent="1" edge="1" source="worker-a" target="buffer-a"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e2" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#70ad47;strokeWidth=2;endArrow=block;" parent="1" edge="1" source="worker-a" target="checkpoint-a"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e-crash" value="Memory lost" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#b85450;strokeWidth=2;endArrow=block;flowAnimation=1;fontSize=12;" parent="1" edge="1" source="buffer-a" target="crash"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e4" value="Worker B takes over" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#4472c4;strokeWidth=2;endArrow=block;flowAnimation=1;fontSize=12;" parent="1" edge="1" source="crash" target="assign"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e5" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#4472c4;strokeWidth=2;endArrow=block;flowAnimation=1;" parent="1" edge="1" source="assign" target="reload"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e5a" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#4472c4;strokeWidth=2;endArrow=block;flowAnimation=1;" parent="1" edge="1" source="reload" target="resume-stream"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e6" value="Read saved changes" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#9673a6;strokeWidth=2;endArrow=block;flowAnimation=1;fontSize=12;" parent="1" edge="1" source="sql-cdc" target="resume-stream"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e7" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#4472c4;strokeWidth=2;endArrow=block;flowAnimation=1;" parent="1" edge="1" source="resume-stream" target="resume-snapshot"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e8" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#d6b656;strokeWidth=2;endArrow=block;flowAnimation=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="resume-snapshot" target="emitted"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1500" y="615" /><mxPoint x="820" y="615" /></Array></mxGeometry></mxCell>
        <mxCell id="e-yes" value="yes" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#b85450;strokeWidth=2;endArrow=block;flowAnimation=1;fontSize=12;" parent="1" edge="1" source="emitted" target="replay"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e-no" value="no" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#70ad47;strokeWidth=2;endArrow=block;fontSize=12;" parent="1" edge="1" source="emitted" target="continue"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e-replay-complete" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#70ad47;strokeWidth=2;endArrow=block;" parent="1" edge="1" source="replay" target="complete"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e-continue-complete" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#70ad47;strokeWidth=2;endArrow=block;" parent="1" edge="1" source="continue" target="complete"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="legend" value="Animated arrows show records moving. Green Kafka stores and purple Azure SQL data survive Worker A." style="html=1;rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=8;" parent="1" vertex="1"><mxGeometry as="geometry" x="40.0" y="1140.0" width="840.0" height="50.0" /></mxCell>
        <mxCell id="azure-sql-icon" value="Azure SQL" style="shape=image;aspect=fixed;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;image=img/lib/azure2/databases/SQL_Database.svg;" parent="durable-zone" vertex="1"><mxGeometry as="geometry" x="540.0" y="180.0" width="60.0" height="60.0" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
