<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio-mcp" modified="2026-08-26T09:00:00.000Z" agent="drawio-mcp/1.0" version="24.7.17" type="device" compressed="false">
  <diagram name="Crash recovery" id="incremental-snapshot-recovery">
    <mxGraphModel dx="1800" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1300" background="none" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Resume from committed snapshot context after worker loss" style="text;align=left;verticalAlign=middle;fontSize=25;fontStyle=1;fontColor=#1f4e79;" parent="1" vertex="1"><mxGeometry as="geometry" x="40" y="20" width="1100" height="40" /></mxCell>
        <mxCell id="subtitle" value="A crash loses memory. Durable offsets, including SQL Server's log sequence number (LSN), and change data capture (CDC) rows determine replay." style="text;align=left;verticalAlign=middle;fontSize=14;fontColor=#555555;" parent="1" vertex="1"><mxGeometry as="geometry" x="40" y="60" width="1400" height="30" /></mxCell>
        <mxCell id="before-zone" value="Before the crash: Worker A" style="swimlane;startSize=24;whiteSpace=wrap;fillColor=#fff8e6;strokeColor=#d6b656;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=15;fontStyle=1;connectable=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="40" y="120" width="500" height="470" /></mxCell>
        <mxCell id="durable-zone" value="Durable state that survives" style="swimlane;startSize=24;whiteSpace=wrap;fillColor=#f1f8f1;strokeColor=#70ad47;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=15;fontStyle=1;connectable=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="580" y="120" width="650" height="470" /></mxCell>
        <mxCell id="after-zone" value="After reassignment: Worker B" style="swimlane;startSize=24;whiteSpace=wrap;fillColor=#f5f9ff;strokeColor=#4472c4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=15;fontStyle=1;connectable=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="1260" y="120" width="490" height="470" /></mxCell>
        <mxCell id="worker-a" value="1  Connector is streaming&#xa;and snapshotting a chunk" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" parent="before-zone" vertex="1"><mxGeometry as="geometry" x="50" y="70" width="210" height="80" /></mxCell>
        <mxCell id="buffer-a" value="In-memory window buffer&#xa;READ events for current chunk" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" parent="before-zone" vertex="1"><mxGeometry as="geometry" x="300" y="70" width="170" height="80" /></mxCell>
        <mxCell id="checkpoint-a" value="2  Periodic checkpoint&#xa;Commit log sequence number (LSN)&#xa;and snapshot context&#xa;to connect-offsets" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=13;fontStyle=1;" parent="before-zone" vertex="1"><mxGeometry as="geometry" x="50" y="220" width="210" height="90" /></mxCell>
        <mxCell id="crash" value="3  Worker A crashes&#xa;Buffer disappears immediately&#xa;OPEN may have no matching CLOSE yet" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=14;fontStyle=1;" parent="before-zone" vertex="1"><mxGeometry as="geometry" x="300" y="340" width="170" height="100" /></mxCell>
        <mxCell id="connect-configs" value="connect-configs&#xa;connector configuration" style="shape=cylinder;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=13;fontStyle=1;" parent="durable-zone" vertex="1"><mxGeometry as="geometry" x="40" y="60" width="170" height="90" /></mxCell>
        <mxCell id="connect-offsets" value="connect-offsets&#xa;committed SQL LSN&#xa;+ incremental snapshot context" style="shape=cylinder;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=13;fontStyle=1;" parent="durable-zone" vertex="1"><mxGeometry as="geometry" x="40" y="250" width="180" height="110" /></mxCell>
        <mxCell id="schema-history" value="schema-history-{tenantId}&#xa;schema needed to decode&#xa;historical changes" style="shape=cylinder;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=13;fontStyle=1;" parent="durable-zone" vertex="1"><mxGeometry as="geometry" x="260" y="50" width="170" height="110" /></mxCell>
        <mxCell id="sql-cdc" value="SQL Server CDC rows&#xa;changes remain until cleanup&#xa;retention removes them" style="shape=cylinder;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" parent="durable-zone" vertex="1"><mxGeometry as="geometry" x="460" y="250" width="170" height="110" /></mxCell>
        <mxCell id="signal-offset" value="__consumer_offsets&#xa;last committed signal position&#xa;not proof that snapshot started" style="shape=cylinder;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=13;fontStyle=1;" parent="durable-zone" vertex="1"><mxGeometry as="geometry" x="250" y="250" width="180" height="110" /></mxCell>
        <mxCell id="signal-markers" value="dbo.DebeziumSignal&#xa;window markers in CDC&#xa;not the restart cursor" style="shape=cylinder;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" parent="durable-zone" vertex="1"><mxGeometry as="geometry" x="460" y="50" width="170" height="110" /></mxCell>
        <mxCell id="assign" value="4  Connect assigns the&#xa;connector to Worker B" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#4472c4;fontSize=14;fontStyle=1;" parent="after-zone" vertex="1"><mxGeometry as="geometry" x="10" y="340" width="170" height="90" /></mxCell>
        <mxCell id="reload" value="5  Reload durable state&#xa;config + schema + offsets" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=14;fontStyle=1;" parent="after-zone" vertex="1"><mxGeometry as="geometry" x="190" y="340" width="170" height="90" /></mxCell>
        <mxCell id="resume-stream" value="6  Resume CDC from the&#xa;last committed LSN" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;" parent="after-zone" vertex="1"><mxGeometry as="geometry" x="50" y="190" width="190" height="90" /></mxCell>
        <mxCell id="resume-snapshot" value="7  Resume after the last&#xa;committed snapshot key&#xa;rebuild window and buffer" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#4472c4;fontSize=14;fontStyle=1;" parent="after-zone" vertex="1"><mxGeometry as="geometry" x="290" y="190" width="180" height="110" /></mxCell>
        <mxCell id="duplicate-zone" value="At-least-once boundary" style="swimlane;startSize=24;whiteSpace=wrap;fillColor=#fff8e6;strokeColor=#d6b656;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=15;fontStyle=1;connectable=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="40" y="640" width="1710" height="460" /></mxCell>
        <mxCell id="emitted" value="8  Was a record published&#xa;before the crash but not covered&#xa;by the committed offset?" style="rhombus;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" parent="duplicate-zone" vertex="1"><mxGeometry as="geometry" x="1450" y="80" width="230" height="150" /></mxCell>
        <mxCell id="replay" value="Yes: emit it again&#xa;Duplicate is allowed&#xa;downstream must ignore duplicates safely" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" parent="duplicate-zone" vertex="1"><mxGeometry as="geometry" x="1110" y="70" width="230" height="100" /></mxCell>
        <mxCell id="continue" value="No: continue from the&#xa;committed boundary" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=13;fontStyle=1;" parent="duplicate-zone" vertex="1"><mxGeometry as="geometry" x="1110" y="210" width="230" height="70" /></mxCell>
        <mxCell id="complete" value="9  Finish remaining chunks&#xa;and commit completed state" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=14;fontStyle=1;" parent="duplicate-zone" vertex="1"><mxGeometry as="geometry" x="780" y="140" width="240" height="90" /></mxCell>
        <mxCell id="signal-outcomes" value="Kafka command checkpoint outcomes&#xa;- Signal position not committed: the command can be polled again. A duplicate snapshot request is possible.&#xa;- Signal position committed but no Connect snapshot context: the signal consumer resumes after the command. An external retrigger can be required.&#xa;- Neither outcome proves whether snapshot rows were published." style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;align=left;spacingLeft=10;" parent="duplicate-zone" vertex="1"><mxGeometry as="geometry" x="40" y="60" width="540" height="170" /></mxCell>
        <mxCell id="limits" value="Recovery limits&#xa;- SQL CDC retention must still contain the committed LSN.&#xa;- Losing connect-offsets or schema history is a different recovery incident.&#xa;- SQL Server schema changes are unsupported during an incremental snapshot.&#xa;- Normal resume is documented design, not yet container-proven by #68." style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#999999;fontSize=13;fontStyle=1;align=left;spacingLeft=10;" parent="duplicate-zone" vertex="1"><mxGeometry as="geometry" x="40" y="250" width="540" height="160" /></mxCell>
        <mxCell id="e1" value="current READs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#d6b656;strokeWidth=2;endArrow=block;fontSize=11;" parent="1" edge="1" source="worker-a" target="buffer-a"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#70ad47;strokeWidth=2;endArrow=block;" parent="1" edge="1" source="worker-a" target="checkpoint-a"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e-crash" value="memory lost" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#b85450;strokeWidth=2;endArrow=block;flowAnimation=1;fontSize=11;" parent="1" edge="1" source="buffer-a" target="crash"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e4" value="reassign" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#4472c4;strokeWidth=2;endArrow=block;flowAnimation=1;fontSize=11;" parent="1" edge="1" source="crash" target="assign"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#4472c4;strokeWidth=2;endArrow=block;flowAnimation=1;" parent="1" edge="1" source="assign" target="reload"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e5a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#4472c4;strokeWidth=2;endArrow=block;flowAnimation=1;" parent="1" edge="1" source="reload" target="resume-stream"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e6" value="stream changes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#9673a6;strokeWidth=2;endArrow=block;flowAnimation=1;fontSize=11;" parent="1" edge="1" source="sql-cdc" target="resume-stream"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#4472c4;strokeWidth=2;endArrow=block;flowAnimation=1;" parent="1" edge="1" source="resume-stream" target="resume-snapshot"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#d6b656;strokeWidth=2;endArrow=block;flowAnimation=1;" parent="1" edge="1" source="resume-snapshot" target="emitted"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e-yes" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#b85450;strokeWidth=2;endArrow=block;flowAnimation=1;fontSize=11;" parent="1" edge="1" source="emitted" target="replay"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e-no" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#70ad47;strokeWidth=2;endArrow=block;fontSize=11;" parent="1" edge="1" source="emitted" target="continue"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e-replay-complete" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#70ad47;strokeWidth=2;endArrow=block;" parent="1" edge="1" source="replay" target="complete"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e-continue-complete" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#70ad47;strokeWidth=2;endArrow=block;" parent="1" edge="1" source="continue" target="complete"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="legend" value="Animated arrows = runtime flow. Green and purple cylinder shapes = durable state that survives Worker A." style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1"><mxGeometry as="geometry" x="40" y="1140" width="840" height="50" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
