  <diagram name="Tenant onboarding" id="tenant-onboarding">
    <mxGraphModel dx="1354" dy="981" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="920" background="none" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Onboard one tenant and prove events are flowing" style="text;html=1;align=left;verticalAlign=middle;fontSize=25;fontStyle=1;fontColor=#1f4e79;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40.0" y="20.0" width="1300.0" height="40.0" />
        </mxCell>
        <mxCell id="subtitle" value="Use the same manifest for database setup and connector routing. Finish each check before moving to the next area." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#555555;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40.0" y="60.0" width="1400.0" height="30.0" />
        </mxCell>
        <mxCell id="inputs-zone" value="Inputs from the deployment operator" style="swimlane;startSize=28;whiteSpace=wrap;html=1;fillColor=#f5f9ff;strokeColor=#4472c4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=15;fontStyle=1;connectable=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40.0" y="120.0" width="270.0" height="650.0" />
        </mxCell>
        <mxCell id="database-zone" value="Prepare and check the tenant database" style="swimlane;startSize=28;whiteSpace=wrap;html=1;fillColor=#f4ecf7;strokeColor=#9673a6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=15;fontStyle=1;connectable=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="340.0" y="120.0" width="520.0" height="650.0" />
        </mxCell>
        <mxCell id="connect-zone" value="Create and start the connector" style="swimlane;startSize=28;whiteSpace=wrap;html=1;fillColor=#fff8e6;strokeColor=#d6b656;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=15;fontStyle=1;connectable=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="890.0" y="120.0" width="400.0" height="650.0" />
        </mxCell>
        <mxCell id="proof-zone" value="Prove one event end to end" style="swimlane;startSize=28;whiteSpace=wrap;html=1;fillColor=#f1f8f1;strokeColor=#70ad47;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=15;fontStyle=1;connectable=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1320.0" y="120.0" width="430.0" height="650.0" />
        </mxCell>
        <mxCell id="step1" value="1 Gather runtime inputs&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;tenant manifest&lt;br&gt;admin connection string&lt;br&gt;connector identity name&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4472c4;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="80.0" y="210.0" width="190.0" height="130.0" />
        </mxCell>
        <mxCell id="input-note" value="Do not commit or print the manifest, connection string, or generated connector files." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="70.0" y="430.0" width="210.0" height="110.0" />
        </mxCell>
        <mxCell id="step2" value="2 Run tenant onboarding&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;creates tables and TenantInfo&lt;br&gt;enables snapshot isolation&lt;br&gt;applies connector grants when supplied&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="380.0" y="190.0" width="210.0" height="130.0" />
        </mxCell>
        <mxCell id="step3" value="3 Check database features&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;CDC: Outbox + DebeziumSignal&lt;br&gt;Change Tracking: WorkflowTask&lt;br&gt;TenantInfo: expected tenant&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="620.0" y="190.0" width="210.0" height="130.0" />
        </mxCell>
        <mxCell id="step4" value="4 Run onboarding again&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;the same command must succeed&lt;br&gt;and leave the same database contract&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="500.0" y="410.0" width="220.0" height="110.0" />
        </mxCell>
        <mxCell id="sql-icon" value="Azure SQL" style="shape=image;aspect=fixed;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;image=img/lib/azure2/databases/SQL_Database.svg;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="740.0" y="590.0" width="60.0" height="60.0" />
        </mxCell>
        <mxCell id="step5" value="5 Generate connector files&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;use the same manifest&lt;br&gt;ActiveDirectoryDefault&lt;br&gt;no database credentials&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="970.0" y="200.0" width="230.0" height="120.0" />
        </mxCell>
        <mxCell id="step6" value="6 Register with Kafka Connect&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;POST the complete generated file&lt;br&gt;wait for connector and task RUNNING&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="970.0" y="420.0" width="230.0" height="110.0" />
        </mxCell>
        <mxCell id="step7" value="7 Commit one task change&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;task-api writes WorkflowTask and Outbox&lt;br&gt;in one database transaction&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1380.0" y="210.0" width="310.0" height="110.0" />
        </mxCell>
        <mxCell id="step8" value="8 Check the Kafka event&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;correct shared or isolated topic&lt;br&gt;key: {tenantId}-{taskId}&lt;br&gt;tenantId header and expected event type&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1380.0" y="430.0" width="310.0" height="130.0" />
        </mxCell>
        <mxCell id="stop-note" value="Stop at the first failed check. Fix that layer before testing the next one." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1360.0" y="640.0" width="350.0" height="70.0" />
        </mxCell>
