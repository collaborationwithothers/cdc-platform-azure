        <mxCell id="subtitle" value="Authentication proves who a caller is. Authorization limits what that identity can do. Attribution checks which tenant an event belongs to." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#555555;" parent="1" vertex="1">
