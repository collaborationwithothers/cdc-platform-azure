        </mxCell>
        <mxCell id="check1" value="1 Outbox row exists?&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;same transaction as the task change&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4472c4;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="70.0" y="220.0" width="230.0" height="100.0" />
        </mxCell>
        <mxCell id="check2" value="2 CDC captured it?&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Outbox capture instance advances&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="350.0" y="220.0" width="230.0" height="100.0" />
        </mxCell>
        <mxCell id="check3" value="3 Connector is moving?&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;task RUNNING and source offset advances&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="630.0" y="220.0" width="230.0" height="100.0" />
        </mxCell>
        <mxCell id="check4" value="4 Record is on the expected topic?&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;shared or stream-isolated route&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="910.0" y="220.0" width="230.0" height="100.0" />
        </mxCell>
        <mxCell id="check5" value="5 Consumer is moving?&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;group offset advances on this partition&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1190.0" y="220.0" width="230.0" height="100.0" />
        </mxCell>
