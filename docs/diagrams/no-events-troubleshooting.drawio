        <mxCell id="fail-zone" value="If a check fails" style="swimlane;startSize=28;whiteSpace=wrap;html=1;fillColor=#fff8f8;strokeColor=#b85450;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=15;fontStyle=1;connectable=0;" parent="1" vertex="1">
