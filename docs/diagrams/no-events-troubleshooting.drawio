        </mxCell>
        <mxCell id="fix1" value="Inspect task-api and its database transaction&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;no Outbox row means the CDC pipeline never received work&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="70.0" y="570.0" width="230.0" height="110.0" />
        </mxCell>
        <mxCell id="fix2" value="Check onboarding and CDC&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;database CDC on; Outbox and DebeziumSignal captured; retention still covers the row&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="350.0" y="560.0" width="230.0" height="130.0" />
        </mxCell>
        <mxCell id="fix3" value="Check Connect scope first&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;one connector: auth or tenant config&lt;br&gt;fleet-wide: broker or internal topics&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="630.0" y="560.0" width="230.0" height="130.0" />
        </mxCell>
        <mxCell id="fix4" value="Check routing and transforms&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;streamIsolated choice, event key, tenantId header, and transform errors&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="910.0" y="560.0" width="230.0" height="130.0" />
        </mxCell>
        <mxCell id="fix5" value="Check the partition&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;consumer lag, PartitionBlocked, parked events, and consumer errors&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" parent="1" vertex="1">
