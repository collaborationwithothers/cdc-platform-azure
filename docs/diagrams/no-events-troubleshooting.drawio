        <mxCell id="title" value="No event arrived: check one boundary at a time" style="text;html=1;align=left;verticalAlign=middle;fontSize=25;fontStyle=1;fontColor=#1f4e79;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40.0" y="20.0" width="1300.0" height="40.0" />
        </mxCell>
        <mxCell id="subtitle" value="Choose one tenant, task, and version. Start at the source row and stop at the first boundary that has no evidence." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#555555;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40.0" y="60.0" width="1500.0" height="30.0" />
        </mxCell>
