  <diagram name="Tenant routing and isolation" id="tenant-routing-isolation">
    <mxGraphModel dx="1354" dy="981" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" background="none" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="How one tenant reaches the correct Kafka stream" style="text;html=1;align=left;verticalAlign=middle;fontSize=25;fontStyle=1;fontColor=#1f4e79;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40.0" y="20.0" width="1300.0" height="40.0" />
        </mxCell>
        <mxCell id="subtitle" value="The task key is written in the tenant database. The connector adds the tenant header and chooses the shared or dedicated stream." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#555555;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40.0" y="60.0" width="1500.0" height="30.0" />
        </mxCell>
        <mxCell id="source-zone" value="Tenant source" style="swimlane;startSize=28;whiteSpace=wrap;html=1;fillColor=#f4ecf7;strokeColor=#9673a6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=15;fontStyle=1;connectable=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40.0" y="120.0" width="470.0" height="650.0" />
        </mxCell>
        <mxCell id="connector-zone" value="Connector configuration and transforms" style="swimlane;startSize=28;whiteSpace=wrap;html=1;fillColor=#fff8e6;strokeColor=#d6b656;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=15;fontStyle=1;connectable=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="540.0" y="120.0" width="500.0" height="650.0" />
        </mxCell>
        <mxCell id="stream-zone" value="Kafka streams on shared brokers" style="swimlane;startSize=28;whiteSpace=wrap;html=1;fillColor=#f1f8f1;strokeColor=#70ad47;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=15;fontStyle=1;connectable=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1070.0" y="120.0" width="680.0" height="650.0" />
        </mxCell>
        <mxCell id="task-api" value="1 task-api commits a change&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;writes WorkflowTask and Outbox together&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4472c4;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="80.0" y="230.0" width="190.0" height="100.0" />
        </mxCell>
        <mxCell id="outbox" value="2 dbo.Outbox&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;AggregateId = {tenantId}-{taskId}&lt;br&gt;this becomes the Kafka key&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="300.0" y="220.0" width="170.0" height="120.0" />
        </mxCell>
        <mxCell id="manifest" value="Tenant manifest&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;tenantId&lt;br&gt;database&lt;br&gt;streamIsolated&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="80.0" y="500.0" width="170.0" height="120.0" />
        </mxCell>
        <mxCell id="tenant-info" value="dbo.TenantInfo&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;source claim for tenant attribution checks&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="300.0" y="500.0" width="170.0" height="100.0" />
        </mxCell>
        <mxCell id="sql-icon" value="Azure SQL" style="shape=image;aspect=fixed;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;image=img/lib/azure2/databases/SQL_Database.svg;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="100.0" y="650.0" width="55.0" height="55.0" />
        </mxCell>
        <mxCell id="connector" value="3 One connector per tenant&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;reads only that tenant database&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="590.0" y="230.0" width="190.0" height="100.0" />
        </mxCell>
        <mxCell id="transforms" value="4 Stock transforms&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;outbox unwraps the event&lt;br&gt;tenantHeader adds tenantId&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="820.0" y="220.0" width="190.0" height="120.0" />
        </mxCell>
        <mxCell id="generator" value="Connector generator&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;uses the manifest to set&lt;br&gt;tenantId header + routing topic&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="590.0" y="500.0" width="190.0" height="110.0" />
        </mxCell>
        <mxCell id="trust-note" value="Header trust boundary&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;a wrong connector constant can stamp the wrong tenantId; the reconciler compares it with TenantInfo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="820.0" y="490.0" width="190.0" height="130.0" />
        </mxCell>
        <mxCell id="choice" value="5 streamIsolated?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1110.0" y="250.0" width="170.0" height="110.0" />
        </mxCell>
        <mxCell id="shared" value="No: shared stream&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;workflow-transitions&lt;br&gt;many tenant keys share 12 partitions&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4472c4;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1330.0" y="170.0" width="200.0" height="120.0" />
        </mxCell>
        <mxCell id="isolated" value="Yes: dedicated stream&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;workflow-transitions-{tenantId}&lt;br&gt;own retention, ACLs, replay, offboarding&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1330.0" y="390.0" width="220.0" height="130.0" />
        </mxCell>
        <mxCell id="consumers" value="6 Shared consumers&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;queue-builder and notifier read both stream shapes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1580.0" y="270.0" width="140.0" height="130.0" />
        </mxCell>
        <mxCell id="isolation-note" value="Dedicated stream is not dedicated infrastructure&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;brokers, Connect workers, and consumers remain shared. Dedicated consumer deployments or clusters are deferred.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#70ad47;fontSize=14;fontStyle=1;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1110.0" y="590.0" width="580.0" height="110.0" />
        </mxCell>
