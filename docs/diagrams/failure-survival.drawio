  <diagram name="Failure survival" id="failure-survival">
    <mxGraphModel dx="1354" dy="981" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1050" background="none" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="What survives each kind of failure" style="text;html=1;align=left;verticalAlign=middle;fontSize=25;fontStyle=1;fontColor=#1f4e79;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40.0" y="20.0" width="1200.0" height="40.0" />
        </mxCell>
        <mxCell id="subtitle" value="Start by naming the failure. A pod restart is a resume problem. A full disposable teardown is a rebuild problem." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#555555;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40.0" y="60.0" width="1500.0" height="30.0" />
        </mxCell>
        <mxCell id="pod-zone" value="Connect pod restarts" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#f5f9ff;strokeColor=#4472c4;strokeWidth=2;verticalAlign=top;align=center;spacingTop=8;fontSize=15;fontStyle=1;connectable=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40.0" y="120.0" width="400.0" height="790.0" />
        </mxCell>
        <mxCell id="worker-zone" value="Connect worker is lost" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#fff8e6;strokeColor=#d6b656;strokeWidth=2;verticalAlign=top;align=center;spacingTop=8;fontSize=15;fontStyle=1;connectable=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="480.0" y="120.0" width="400.0" height="790.0" />
        </mxCell>
        <mxCell id="kafka-zone" value="Kafka or internal topics are lost" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#fceeea;strokeColor=#c55a11;strokeWidth=2;verticalAlign=top;align=center;spacingTop=8;fontSize=15;fontStyle=1;connectable=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="920.0" y="120.0" width="400.0" height="790.0" />
        </mxCell>
        <mxCell id="teardown-zone" value="Disposable environment is recreated" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#f4ecf7;strokeColor=#9673a6;strokeWidth=2;verticalAlign=top;align=center;spacingTop=8;fontSize=15;fontStyle=1;connectable=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1360.0" y="120.0" width="400.0" height="790.0" />
        </mxCell>
        <mxCell id="pod-trigger" value="What stopped&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;one Connect pod&lt;br&gt;its in-memory work is gone&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="100.0" y="200.0" width="280.0" height="100.0" />
        </mxCell>
        <mxCell id="pod-survives" value="What survives&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Azure SQL CDC rows&lt;br&gt;Connect offsets and schema history&lt;br&gt;Kafka output already committed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="100.0" y="370.0" width="280.0" height="120.0" />
        </mxCell>
        <mxCell id="pod-recover" value="Recovery&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Kubernetes starts a pod&lt;br&gt;Connect reloads saved state&lt;br&gt;the connector resumes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4472c4;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="100.0" y="560.0" width="280.0" height="115.0" />
        </mxCell>
        <mxCell id="pod-result" value="Expected result&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;short pause for affected work&lt;br&gt;duplicates remain possible&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="100.0" y="750.0" width="280.0" height="90.0" />
        </mxCell>
        <mxCell id="worker-trigger" value="What stopped&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;one worker process or node&lt;br&gt;only its connectors pause&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="540.0" y="200.0" width="280.0" height="100.0" />
        </mxCell>
        <mxCell id="worker-survives" value="What survives&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;other Connect workers&lt;br&gt;Kafka state and Azure SQL CDC&lt;br&gt;saved connector positions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="540.0" y="370.0" width="280.0" height="120.0" />
        </mxCell>
        <mxCell id="worker-recover" value="Recovery&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;distributed Connect assigns affected connectors to surviving workers and reloads their state&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4472c4;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="540.0" y="560.0" width="280.0" height="115.0" />
        </mxCell>
        <mxCell id="worker-result" value="Expected result&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;unaffected connectors continue&lt;br&gt;duplicates remain possible&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="540.0" y="750.0" width="280.0" height="90.0" />
        </mxCell>
        <mxCell id="kafka-trigger" value="What stopped&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;build-scale Kafka is RF1&lt;br&gt;stream and Connect state may be lost&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="980.0" y="200.0" width="280.0" height="100.0" />
        </mxCell>
        <mxCell id="kafka-survives" value="What survives&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;tenant source rows and Azure SQL CDC while retention still contains them&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="980.0" y="370.0" width="280.0" height="120.0" />
        </mxCell>
        <mxCell id="kafka-recover" value="Recovery&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;restore Kafka and Connect state&lt;br&gt;register connectors&lt;br&gt;trigger snapshots when required&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4472c4;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="980.0" y="560.0" width="280.0" height="115.0" />
        </mxCell>
        <mxCell id="kafka-result" value="Expected result&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;fleet-wide recovery&lt;br&gt;possible Kafka data loss&lt;br&gt;mass re-snapshot is not automated&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="980.0" y="740.0" width="280.0" height="110.0" />
        </mxCell>
        <mxCell id="teardown-trigger" value="What stopped&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;AKS, Kafka, tenant databases, and disposable services are recreated&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1420.0" y="200.0" width="280.0" height="100.0" />
        </mxCell>
        <mxCell id="teardown-survives" value="What survives&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;state backend, ACR, Key Vault, Log Analytics, Application Insights, and managed identities&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1420.0" y="370.0" width="280.0" height="120.0" />
        </mxCell>
        <mxCell id="teardown-recover" value="Recovery&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;recreate disposable resources&lt;br&gt;rerun onboarding&lt;br&gt;initial snapshots + reconciler bootstrap&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4472c4;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1420.0" y="560.0" width="280.0" height="115.0" />
        </mxCell>
        <mxCell id="teardown-result" value="Expected result&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;queues rebuild from source truth&lt;br&gt;there is no cross-session replay&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1420.0" y="750.0" width="280.0" height="90.0" />
        </mxCell>
