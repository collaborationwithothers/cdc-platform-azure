  <diagram name="Channels and state" id="incremental-snapshot-channels">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" background="none" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="One trigger, two signal channels, and separate state stores" style="text;html=1;align=left;verticalAlign=middle;fontSize=25;fontStyle=1;fontColor=#1f4e79;" parent="1" vertex="1"><mxGeometry as="geometry" x="40" y="20" width="1200" height="40" /></mxCell>
        <mxCell id="subtitle" value="The Kafka topic starts the work. SQL Server change data capture (CDC) orders OPEN and CLOSE watermarks with live changes." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#555555;" parent="1" vertex="1"><mxGeometry as="geometry" x="40" y="60" width="1300" height="30" /></mxCell>
        <mxCell id="command-zone" value="Command channel" style="swimlane;startSize=24;whiteSpace=wrap;html=1;fillColor=#f5f9ff;strokeColor=#4472c4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=15;fontStyle=1;connectable=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="40" y="120" width="390" height="450" /></mxCell>
        <mxCell id="connector-zone" value="Debezium SQL Server connector: tenant-{tenantId}-outbox" style="swimlane;startSize=24;whiteSpace=wrap;html=1;fillColor=#fff8e6;strokeColor=#d6b656;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=15;fontStyle=1;connectable=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="460" y="120" width="740" height="450" /></mxCell>
        <mxCell id="sql-zone" value="Tenant SQL Server database" style="swimlane;startSize=24;whiteSpace=wrap;html=1;fillColor=#f4ecf7;strokeColor=#9673a6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=15;fontStyle=1;connectable=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="1230" y="120" width="520" height="450" /></mxCell>
        <mxCell id="caller" value="Snapshot caller&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;operations identity&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4472c4;fontSize=14;fontStyle=1;" parent="command-zone" vertex="1"><mxGeometry as="geometry" x="40" y="80" width="150" height="70" /></mxCell>
        <mxCell id="signals" value="connect-signals&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;1 partition; trigger only&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4472c4;fontSize=13;fontStyle=1;" parent="command-zone" vertex="1"><mxGeometry as="geometry" x="240" y="80" width="120" height="90" /></mxCell>
        <mxCell id="signal-message" value="Key: tenant-{tenantId}&lt;br&gt;Value: execute-snapshot&lt;br&gt;Table: {database}.dbo.Outbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" parent="command-zone" vertex="1"><mxGeometry as="geometry" x="50" y="240" width="300" height="90" /></mxCell>
        <mxCell id="kafka-channel" value="KafkaSignalChannel&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;consumes the command&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" parent="connector-zone" vertex="1"><mxGeometry as="geometry" x="40" y="80" width="170" height="80" /></mxCell>
        <mxCell id="coordinator" value="Incremental snapshot&lt;br&gt;coordinator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=14;fontStyle=1;" parent="connector-zone" vertex="1"><mxGeometry as="geometry" x="290" y="80" width="180" height="90" /></mxCell>
        <mxCell id="source-channel" value="SourceSignalChannel&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;writes chunk watermarks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" parent="connector-zone" vertex="1"><mxGeometry as="geometry" x="530" y="80" width="180" height="80" /></mxCell>
        <mxCell id="buffer" value="Snapshot-window buffer&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;READ events by primary key&lt;br&gt;memory only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" parent="connector-zone" vertex="1"><mxGeometry as="geometry" x="530" y="240" width="180" height="90" /></mxCell>
        <mxCell id="smt" value="Transform chain (SMT)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;outbox -&gt; tenantHeader&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" parent="connector-zone" vertex="1"><mxGeometry as="geometry" x="290" y="250" width="180" height="80" /></mxCell>
        <mxCell id="signal-table" value="dbo.DebeziumSignal&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;OPEN and CLOSE rows&lt;br&gt;INSERT + SELECT grant&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" parent="sql-zone" vertex="1"><mxGeometry as="geometry" x="40" y="70" width="150" height="110" /></mxCell>
        <mxCell id="outbox" value="dbo.Outbox&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;current rows + live writes&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4472c4;fontSize=13;fontStyle=1;" parent="sql-zone" vertex="1"><mxGeometry as="geometry" x="40" y="250" width="150" height="100" /></mxCell>
        <mxCell id="cdc" value="SQL Server CDC stream&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;one ordered source path&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" parent="sql-zone" vertex="1"><mxGeometry as="geometry" x="280" y="150" width="190" height="90" /></mxCell>
        <mxCell id="state-zone" value="Kafka topics and durable positions" style="swimlane;startSize=24;whiteSpace=wrap;html=1;fillColor=#f1f8f1;strokeColor=#70ad47;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=15;fontStyle=1;connectable=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="40" y="610" width="1710" height="280" /></mxCell>
        <mxCell id="consumer-offsets" value="__consumer_offsets&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;kafka-signal poll position&lt;br&gt;Does not prove snapshot start&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=13;fontStyle=1;" parent="state-zone" vertex="1"><mxGeometry as="geometry" x="50" y="80" width="210" height="110" /></mxCell>
        <mxCell id="connect-offsets" value="connect-offsets&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;SQL Server log sequence number (LSN)&lt;br&gt;+ snapshot context&lt;br&gt;Where should source work resume?&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=13;fontStyle=1;" parent="state-zone" vertex="1"><mxGeometry as="geometry" x="380" y="80" width="240" height="110" /></mxCell>
        <mxCell id="schema-history" value="schema-history-{tenantId}&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;table schema over time&lt;br&gt;Not the snapshot cursor&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=13;fontStyle=1;" parent="state-zone" vertex="1"><mxGeometry as="geometry" x="1100" y="80" width="230" height="110" /></mxCell>
        <mxCell id="workflow" value="workflow-transitions&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;snapshot READs and live events&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#fce4d6;strokeColor=#c55a11;fontSize=13;fontStyle=1;" parent="state-zone" vertex="1"><mxGeometry as="geometry" x="750" y="80" width="220" height="110" /></mxCell>
        <mxCell id="caveat" value="Current boundaries&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;BLOCKER: onboarding does not yet enable CDC on dbo.DebeziumSignal.&lt;br&gt;VERIFY: all three connectors currently inherit group id kafka-signal on one shared partition. Multi-connector delivery is not proven.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;align=left;spacingLeft=10;" parent="state-zone" vertex="1"><mxGeometry as="geometry" x="1380" y="60" width="290" height="150" /></mxCell>
        <mxCell id="e1" value="1  publish trigger" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4472c4;strokeWidth=2;endArrow=block;flowAnimation=1;fontSize=11;" parent="1" edge="1" source="caller" target="signals"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e2" value="2  consume" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4472c4;strokeWidth=2;endArrow=block;flowAnimation=1;fontSize=11;" parent="1" edge="1" source="signals" target="kafka-channel"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e3" value="3  start snapshot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;strokeWidth=2;endArrow=block;flowAnimation=1;fontSize=11;" parent="1" edge="1" source="kafka-channel" target="coordinator"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e4" value="4  write OPEN / CLOSE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;flowAnimation=1;fontSize=11;" parent="1" edge="1" source="source-channel" target="signal-table"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e4a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;strokeWidth=2;endArrow=block;" parent="1" edge="1" source="coordinator" target="source-channel"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e5" value="5  CDC captures watermarks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;flowAnimation=1;fontSize=11;" parent="1" edge="1" source="signal-table" target="cdc"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e6" value="6  live changes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;flowAnimation=1;fontSize=11;" parent="1" edge="1" source="outbox" target="cdc"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e6a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;flowAnimation=1;fontSize=11;" parent="1" edge="1" source="cdc" target="coordinator"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e-read" value="read chunk" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4472c4;strokeWidth=2;endArrow=block;fontSize=11;" parent="1" edge="1" source="outbox" target="buffer"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e-buffer" value="deduped records" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;strokeWidth=2;endArrow=block;fontSize=11;" parent="1" edge="1" source="buffer" target="smt"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e7" value="7  publish" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#c55a11;strokeWidth=2;endArrow=block;flowAnimation=1;fontSize=11;" parent="1" edge="1" source="smt" target="workflow"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e-consumer-offset" value="command position" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#70ad47;endArrow=block;fontSize=10;" parent="1" edge="1" source="kafka-channel" target="consumer-offsets"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e-connect-offset" value="source + snapshot context" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#70ad47;endArrow=block;fontSize=10;" parent="1" edge="1" source="coordinator" target="connect-offsets"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="e-schema" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#70ad47;endArrow=block;fontSize=10;" parent="1" edge="1" source="coordinator" target="schema-history"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="legend" value="Animated solid arrows = records or commands in motion. Dashed arrows = durable checkpoint writes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1"><mxGeometry as="geometry" x="40" y="930" width="780" height="50" /></mxCell>
