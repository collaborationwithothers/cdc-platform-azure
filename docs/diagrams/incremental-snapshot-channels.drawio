  <diagram name="Channels and state" id="incremental-snapshot-channels">
    <mxGraphModel dx="1354" dy="981" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" background="none" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="How a snapshot request becomes database events" style="text;html=1;align=left;verticalAlign=middle;fontSize=25;fontStyle=1;fontColor=#1f4e79;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40.0" y="20.0" width="1200.0" height="40.0" />
        </mxCell>
        <mxCell id="subtitle" value="Each tenant has its own Kafka command topic and consumer bookmark. Azure SQL change data capture (CDC) orders snapshot markers and live row changes." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#555555;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40.0" y="60.0" width="1300.0" height="30.0" />
        </mxCell>
        <mxCell id="command-zone" value="Snapshot request" style="swimlane;startSize=24;whiteSpace=wrap;html=1;fillColor=#f5f9ff;strokeColor=#4472c4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=15;fontStyle=1;connectable=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40.0" y="120.0" width="390.0" height="450.0" />
        </mxCell>
        <mxCell id="connector-zone" value="One Debezium connector for one tenant" style="swimlane;startSize=24;whiteSpace=wrap;html=1;fillColor=#fff8e6;strokeColor=#d6b656;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=15;fontStyle=1;connectable=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="460.0" y="120.0" width="740.0" height="450.0" />
        </mxCell>
        <mxCell id="sql-zone" value="Tenant Azure SQL database" style="swimlane;startSize=24;whiteSpace=wrap;html=1;fillColor=#f4ecf7;strokeColor=#9673a6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=15;fontStyle=1;connectable=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1230.0" y="120.0" width="520.0" height="450.0" />
        </mxCell>
        <mxCell id="caller" value="Operator or automation&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;publishes a snapshot request&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4472c4;fontSize=14;fontStyle=1;" parent="command-zone" vertex="1">
          <mxGeometry as="geometry" x="30.0" y="80.0" width="150.0" height="80.0" />
        </mxCell>
        <mxCell id="signals" value="connect-signals-{tenantId}&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;one topic per tenant, one partition&lt;br&gt;snapshot commands only&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4472c4;fontSize=13;fontStyle=1;" parent="command-zone" vertex="1">
          <mxGeometry as="geometry" x="210" y="80.0" width="170" height="100.0" />
        </mxCell>
        <mxCell id="signal-message" value="Topic: connect-signals-{tenantId}&lt;br&gt;Key: topic.prefix = tenant-{tenantId}&lt;br&gt;Value JSON:&lt;br&gt;type: execute-snapshot&lt;br&gt;data.type: INCREMENTAL&lt;br&gt;data.data-collections: [&quot;{database}.dbo.Outbox&quot;]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;" parent="command-zone" vertex="1">
          <mxGeometry as="geometry" x="50.0" y="200" width="300.0" height="150" />
        </mxCell>
        <mxCell id="kafka-channel" value="Kafka signal reader&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;group: kafka-signal-{tenantId}&lt;br&gt;reads only this tenant's topic&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" parent="connector-zone" vertex="1">
          <mxGeometry as="geometry" x="40.0" y="80.0" width="190" height="95" />
        </mxCell>
        <mxCell id="coordinator" value="Snapshot coordinator&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;runs one chunk at a time&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=14;fontStyle=1;" parent="connector-zone" vertex="1">
          <mxGeometry as="geometry" x="290.0" y="80.0" width="180.0" height="90.0" />
        </mxCell>
        <mxCell id="source-channel" value="Database signal writer&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;writes OPEN and CLOSE&lt;br&gt;around each chunk&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" parent="connector-zone" vertex="1">
          <mxGeometry as="geometry" x="530.0" y="80.0" width="180.0" height="80.0" />
        </mxCell>
        <mxCell id="buffer" value="Snapshot buffer&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;holds READ events by primary key&lt;br&gt;live events remove older READs&lt;br&gt;lost when the worker stops&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" parent="connector-zone" vertex="1">
          <mxGeometry as="geometry" x="280.0" y="230.0" width="200.0" height="110.0" />
        </mxCell>
        <mxCell id="smt" value="Kafka Connect transforms&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;dropNonOutbox -&gt; outbox -&gt; tenantHeader&lt;br&gt;keep Outbox -&gt; unwrap -&gt; add tenant&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" parent="connector-zone" vertex="1">
          <mxGeometry as="geometry" x="10.0" y="240.0" width="220.0" height="110.0" />
        </mxCell>
        <mxCell id="cdc-reader" value="Change stream reader&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;reads markers and live changes&lt;br&gt;in database order&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" parent="connector-zone" vertex="1">
          <mxGeometry as="geometry" x="530.0" y="350.0" width="180.0" height="70.0" />
        </mxCell>
        <mxCell id="signal-table" value="dbo.DebeziumSignal&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;OPEN and CLOSE rows&lt;br&gt;CDC enabled&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" parent="sql-zone" vertex="1">
          <mxGeometry as="geometry" x="40.0" y="70.0" width="150.0" height="110.0" />
        </mxCell>
        <mxCell id="outbox" value="dbo.Outbox&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;current rows and live writes&lt;br&gt;CDC enabled&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4472c4;fontSize=13;fontStyle=1;" parent="sql-zone" vertex="1">
          <mxGeometry as="geometry" x="40.0" y="250.0" width="150.0" height="100.0" />
        </mxCell>
        <mxCell id="cdc" value="Azure SQL CDC stream&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;one ordered path&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" parent="sql-zone" vertex="1">
          <mxGeometry as="geometry" x="280.0" y="150.0" width="190.0" height="90.0" />
        </mxCell>
        <mxCell id="state-zone" value="Kafka topics and durable positions" style="swimlane;startSize=24;whiteSpace=wrap;html=1;fillColor=#f1f8f1;strokeColor=#70ad47;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=15;fontStyle=1;connectable=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40.0" y="610.0" width="1710.0" height="280.0" />
        </mxCell>
        <mxCell id="consumer-offsets" value="__consumer_offsets&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;kafka-signal-{tenantId}&lt;br&gt;saves this tenant's command position&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=13;fontStyle=1;" parent="state-zone" vertex="1">
          <mxGeometry as="geometry" x="50.0" y="80.0" width="210.0" height="110.0" />
        </mxCell>
        <mxCell id="connect-offsets" value="connect-offsets&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;saved Azure SQL log position&lt;br&gt;and snapshot progress&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=13;fontStyle=1;" parent="state-zone" vertex="1">
          <mxGeometry as="geometry" x="300.0" y="80.0" width="240.0" height="110.0" />
        </mxCell>
        <mxCell id="schema-history" value="schema-history-{tenantId}&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;table definitions over time&lt;br&gt;not snapshot progress&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#70ad47;fontSize=13;fontStyle=1;" parent="state-zone" vertex="1">
          <mxGeometry as="geometry" x="1100.0" y="80.0" width="230.0" height="110.0" />
        </mxCell>
        <mxCell id="workflow" value="workflow-transitions&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;snapshot READs and live events&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#fce4d6;strokeColor=#c55a11;fontSize=13;fontStyle=1;" parent="state-zone" vertex="1">
          <mxGeometry as="geometry" x="590.0" y="80.0" width="250.0" height="120.0" />
        </mxCell>
        <mxCell id="caveat" value="Current container proof&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;The test deletes Tenant A's connector registration, then queues Tenant A's command. After the test registers the connector again, Tenant A processes the command; Tenant B does not re-snapshot.&lt;br&gt;&lt;br&gt;Not proved: live Azure or a Kafka Connect worker-process restart.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;align=left;spacingLeft=10;" parent="state-zone" vertex="1">
          <mxGeometry as="geometry" x="1340.0" y="50.0" width="330.0" height="170.0" />
        </mxCell>
